# Optional free-tier cloud sync. Not needed by npm run local.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# No paid APIs. npm run local enables only the loopback Ollama provider.
AGUIRRA_AI_ENABLED=false
OLLAMA_MODEL=qwen3:4b
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# Optional Google Search grounded responses on the free tier, for guests too.
# Use a dedicated Google AI Studio project WITHOUT Cloud Billing.
# Configure the key only as an encrypted server environment variable.
# Never commit the real key or include it in public/.
GOOGLE_GENERATIVE_AI_API_KEY=
# Set only after verifying that the Google project has no billing enabled:
AGUIRRA_GOOGLE_FREE_TIER=
# Exact opt-in value: confirmed-no-billing
# Internal random secret (32+ characters), matching the SHA-256 in the database.
# Already configured on the hosted Aguirra; not needed by npm run local.
AGUIRRA_GUEST_SECRET=
